package() {
  # config
  install -Dm644 andrzej-tools.conf "$pkgdir/etc/andrzej-tools.conf"
  install -Dm644 efi-backup-restore.md "$pkgdir/usr/share/doc/andrzej-tools/efi-backup-restore.md"

  # scripts
  install -Dm755 ping-watch "$pkgdir/usr/local/sbin/ping-watch"
  install -Dm755 boot-mail  "$pkgdir/usr/local/sbin/boot-mail"
  install -Dm755 auth-watch "$pkgdir/usr/local/sbin/auth-watch"
  install -Dm755 btrbk-backup-fixed "$pkgdir/usr/local/sbin/btrbk-backup-fixed"
  install -Dm755 btrbk-backup-usb   "$pkgdir/usr/local/sbin/btrbk-backup-usb"
  install -Dm755 efi-backup "$pkgdir/usr/local/sbin/efi-backup"

  # systemd units
  install -Dm644 ping-watch.service "$pkgdir/usr/lib/systemd/system/ping-watch.service"
  install -Dm644 ping-watch.timer   "$pkgdir/usr/lib/systemd/system/ping-watch.timer"
  install -Dm644 boot-mail.service  "$pkgdir/usr/lib/systemd/system/boot-mail.service"
  install -Dm644 auth-watch.service "$pkgdir/usr/lib/systemd/system/auth-watch.service"
  install -Dm644 btrbk-backup-fixed.service "$pkgdir/usr/lib/systemd/system/btrbk-backup-fixed.service"
  install -Dm644 btrbk-backup-fixed.timer   "$pkgdir/usr/lib/systemd/system/btrbk-backup-fixed.timer"
  install -Dm644 efi-backup.service "$pkgdir/usr/lib/systemd/system/efi-backup.service"
  install -Dm644 efi-backup.timer "$pkgdir/usr/lib/systemd/system/efi-backup.timer"
}
