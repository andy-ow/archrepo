#!/usr/bin/env bash
set -euo pipefail

groups=()

mountpoint -q /mnt/T7_backup     && groups+=(T7)
mountpoint -q /mnt/san128_backup && groups+=(san128)
mountpoint -q /mnt/sea8tb_backup && groups+=(sea8tb)

if (( ${#groups[@]} == 0 )); then
    echo "Brak zamontowanych dysków USB backupowych."
    exit 1
fi

echo "Uruchamiam btrbk dla grup: ${groups[*]}"

exec /usr/bin/systemd-inhibit \
  --what=shutdown:sleep \
  --mode=delay \
  --who=btrbk-backup-usb \
  --why="ANDRZEJ: USB btrbk backup is running; shutdown/reboot is waiting for backup to finish" \
  /usr/bin/btrbk -c /etc/btrbk/btrbk.conf run "${groups[@]}"
